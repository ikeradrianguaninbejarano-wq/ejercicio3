{
  "name": "ejercicio3",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "serve": "http-server . -p 8080 -c-1",
    "test:html": "html-validate --config .htmlvalidate.json --formatter stylish index.html",
    "test:semantic": "node tests/semantic.mjs",
    "test:security": "node tests/security.mjs",
    "test:a11y": "playwright test tests/accessibility.spec.mjs --project=desktop",
    "test:responsive": "playwright test",
    "test": "npm run test:html && npm run test:semantic && npm run test:security && npm run test:a11y && npm run test:responsive"
  },
  "devDependencies": {
    "html-validate": "10.4.0",
    "http-server": "^14.1.1",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0"
  }
}